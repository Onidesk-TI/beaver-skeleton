{
    "name": "beaverphp/skeleton",
    "description": "Esqueleto de projecto limpo para o Beaver Framework",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-pdo": "*",
        "vlucas/phpdotenv": "^5.7"
    },
    "autoload": {
        "psr-4": {
            "Beaver\\Plugins\\Skeleton\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Beaver\\Plugins\\Skeleton\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/Stubs/"
        ]
    }
}